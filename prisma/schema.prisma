generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ApplicationMetadata {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Patient {
  id             String            @id @default(cuid())
  citizenId      String            @unique
  studentId      String            @unique
  status         String
  title          String
  firstName      String
  lastName       String
  birthDate      DateTime
  gender         String
  bloodGroup     String?
  faculty        String
  major          String
  studyYear      String
  phone          String
  email          String            @unique
  homeAddress    String?
  currentAddress String?
  coverage       String
  coverageStatus String
  allergyNotes   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  treatments     TreatmentRecord[]
  appointments   Appointment[]
  payments       Payment[]
  medicalCertificates MedicalCertificate[]
  triageAssessments TriageAssessment[]

  @@index([firstName, lastName])
}

model TriageAssessment {
  id               String   @id @default(cuid())
  patientId        String
  assessedAt       DateTime @default(now())
  assessorUsername String
  assessorName     String
  temperature      Float?
  bloodPressure    String?
  pulse            Int?
  oxygenSaturation Int?
  weightKg         Float?
  heightCm         Float?
  chiefComplaint   String
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  treatmentRecord  TreatmentRecord?

  @@index([patientId, assessedAt])
}

model Appointment {
  id          String    @id @default(cuid())
  patientId   String
  scheduledAt DateTime
  endsAt      DateTime?
  department  String
  clinician   String?
  reason      String
  status      String    @default("scheduled")
  notes       String?
  result      String?
  originTreatmentId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  resultTreatment TreatmentRecord? @relation("AppointmentResultTreatment")
  originTreatment TreatmentRecord? @relation("AppointmentOriginTreatment", fields: [originTreatmentId], references: [id], onDelete: SetNull)

  @@index([patientId, scheduledAt])
  @@index([originTreatmentId])
}

model Payment {
  id             String    @id @default(cuid())
  patientId      String
  paidAt         DateTime  @default(now())
  referenceCode  String    @unique
  description    String
  amountSatang   Int
  method         String
  status         String    @default("paid")
  receiptNumber  String?   @unique
  receivedSatang Int?
  changeSatang   Int?
  qrPayload      String?
  confirmedAt    DateTime?
  reviewedByUsername String?
  reviewedByName String?
  reviewNote     String?
  slipFileName   String?
  slipMimeType   String?
  slipData       Bytes?
  createdAt      DateTime  @default(now())
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, paidAt])
}

model TreatmentRecord {
  id               String   @id @default(cuid())
  patientId        String
  visitedAt        DateTime @default(now())
  department       String
  diagnosis        String
  clinician        String?
  paymentType      String?
  visitType        String
  visitNumber      String?
  temperature      Float?
  bloodPressure    String?
  pulse            Int?
  oxygenSaturation Int?
  weightKg         Float?
  heightCm         Float?
  chiefComplaint   String?
  diagnosisCode    String?
  diagnosisName    String?
  treatmentPlan    String?
  medicationOrders String?
  appointmentId    String?  @unique
  triageAssessmentId String? @unique
  visitSource      String   @default("walk_in")
  appointmentReason String?
  appointmentScheduledAt DateTime?
  createdAt        DateTime @default(now())
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment      Appointment? @relation("AppointmentResultTreatment", fields: [appointmentId], references: [id], onDelete: SetNull)
  triageAssessment TriageAssessment? @relation(fields: [triageAssessmentId], references: [id], onDelete: SetNull)
  medicationDispense MedicationDispense?
  createdAppointments Appointment[] @relation("AppointmentOriginTreatment")
  medicalCertificates MedicalCertificate[]

  @@index([patientId, visitedAt])
  @@index([visitSource, visitedAt])
}

model MedicationDispense {
  id                 String   @id @default(cuid())
  treatmentRecordId  String   @unique
  status             String   @default("pending")
  notes              String?
  pharmacistUsername String?
  pharmacistName     String?
  dispensedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  treatmentRecord    TreatmentRecord @relation(fields: [treatmentRecordId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model FinancialBudget {
  id              String   @id @default(cuid())
  fiscalYear      Int
  category        String
  allocatedSatang Int
  notes           String?
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([fiscalYear, category])
  @@index([fiscalYear])
}

model FinancialExpense {
  id            String   @id @default(cuid())
  expenseDate   DateTime @default(now())
  referenceCode String   @unique
  category      String
  description   String
  payee         String
  amountSatang  Int
  status        String   @default("pending")
  notes         String?
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([expenseDate])
  @@index([status, expenseDate])
  @@index([category, expenseDate])
}

model Evaluation {
  id                    String    @id @default(cuid())
  employeeCode          String
  employeeName          String
  evaluationRound       String
  qualityScore          Int
  responsibilityScore   Int
  serviceScore          Int
  feedback              String?
  evaluatorKey          String
  systemScores          Json?
  personnelScores       Json?
  organizationScores    Json?
  serviceUnit           String?
  serviceType           String?
  visitorType           String?
  accessType            String?
  waitTimeRange         String?
  problemStage          String?
  problemDetails        String?
  improvementSuggestion String?
  desiredService        String?
  returnIntention       Int?
  recommendationScore   Int?
  anonymous             Boolean   @default(true)
  followupStatus        String    @default("received")
  assessmentType        String?
  assessedUserKey       String?
  assessedName          String?
  assessedRole          String?
  commonScores          Json?
  roleScores            Json?
  strengths             String?
  developmentGoals      String?
  supportNeeded         String?
  actionPlan            String?
  reviewDate            DateTime?
  externalFormId        String?
  externalResponseId    String?   @unique
  sourceAnswers         Json?
  sourceSubmittedAt     DateTime?
  createdAt             DateTime  @default(now())

  @@index([employeeCode, createdAt])
  @@index([assessedUserKey, createdAt])
}

model GoogleFormConnection {
  id                 String               @id @default("service-evaluation")
  formId             String               @unique
  formUrl            String
  sheetCsvUrl        String
  title              String?
  revisionId         String?
  status             String               @default("pending")
  lastSchemaSyncAt   DateTime?
  lastResponseSyncAt DateTime?
  lastError          String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  questions          GoogleFormQuestion[]
}

model GoogleFormQuestion {
  id           String               @id @default(cuid())
  connectionId String
  questionId   String
  title        String
  questionType String
  metricKey    String?
  active       Boolean              @default(true)
  firstSeenAt  DateTime             @default(now())
  lastSeenAt   DateTime             @default(now())
  connection   GoogleFormConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, questionId])
  @@index([connectionId, active])
  @@index([connectionId, metricKey])
}

model UserSettings {
  id                   String   @id @default(cuid())
  userKey              String   @unique
  displayName          String
  role                 String
  email                String
  phone                String
  notifyAnnouncements  Boolean  @default(true)
  notifyMonthlyReports Boolean  @default(true)
  notifySecurity       Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model StaffAccount {
  id             String   @id @default(cuid())
  username       String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           String
  medicalLicense String   @unique
  email          String?  @unique
  phone          String?
  organization   String?
  licenseExpiresAt DateTime?
  authProvider   String   @default("local")
  active         Boolean  @default(true)
  applicationStatus String @default("approved")
  emailVerifiedAt DateTime?
  verificationCodeHash String?
  verificationExpiresAt DateTime?
  reviewedAt     DateTime?
  reviewedBy     String?
  reviewNote     String?
  accessStartsAt DateTime?
  accessEndsAt   DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  medicalCertificates MedicalCertificate[]
  auditLogs      AccountAuditLog[]

  @@index([firstName, lastName])
  @@index([applicationStatus, createdAt])
}

model AccountAuditLog {
  id          String       @id @default(cuid())
  accountId   String
  actorKey    String
  action      String
  fromStatus  String?
  toStatus    String?
  note        String?
  createdAt   DateTime     @default(now())
  account     StaffAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([actorKey, createdAt])
}

model CertificateSequence {
  buddhistYear Int      @id
  nextNumber   Int
  updatedAt    DateTime @updatedAt
}

model MedicalCertificate {
  id                String          @id @default(cuid())
  certificateNumber String          @unique
  patientId         String
  treatmentRecordId String
  doctorId          String
  purpose           String          @default("ใบรับรองการเจ็บป่วย")
  examinedAt        DateTime
  issuedAt          DateTime        @default(now())
  restStartDate     DateTime
  restEndDate       DateTime
  restDays          Int
  doctorName        String
  medicalLicense    String
  patientName       String
  citizenId         String
  studentId         String
  symptom           String
  diagnosis         String
  medicalOpinion    String
  templateVersion   String          @default("illness-v1")
  contentSnapshot   Json
  documentHash      String
  status            String          @default("issued")
  printCount        Int             @default(0)
  lastPrintedAt     DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  patient           Patient         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  treatmentRecord   TreatmentRecord @relation(fields: [treatmentRecordId], references: [id], onDelete: Restrict)
  doctor            StaffAccount    @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([patientId, issuedAt])
  @@index([treatmentRecordId, issuedAt])
}
