# Local development only. Use a new password before deploying elsewhere.
POSTGRES_USER=ku_med
POSTGRES_PASSWORD=ku_med_local_dev
POSTGRES_DB=ku_med
POSTGRES_PORT=5433
APP_PORT=3000
DATABASE_URL=postgresql://ku_med:ku_med_local_dev@localhost:5433/ku_med?schema=public
# เบอร์โทร 10 หลัก หรือเลขประจำตัวผู้เสียภาษี/พร้อมเพย์ 13 หลัก สำหรับรับโอน
NEXT_PUBLIC_PROMPTPAY_ID=
# ข้อมูลแพทย์สำหรับบัญชีทดลอง ใช้ในใบรับรองแพทย์
NEXT_PUBLIC_DEMO_DOCTOR_NAME=
NEXT_PUBLIC_DEMO_MEDICAL_LICENSE=
# API ข้อมูลนิสิต (ฝั่ง server เท่านั้น) ใส่ {studentId} ตรงตำแหน่งรหัสนิสิต
# ตัวอย่าง: https://student-api.example.ac.th/students/{studentId}
STUDENT_LOOKUP_MOCK=false
STUDENT_LOOKUP_API_URL=
# ไม่ต้องใส่ถ้า API ไม่ใช้ Bearer token
STUDENT_LOOKUP_API_TOKEN=
# เครื่องอ่านบัตรประชาชน: disabled | mock | local
CITIZEN_CARD_READER_MODE=mock
# URL ของโปรแกรมเชื่อมต่อเครื่องอ่านบัตรบนเครื่องเจ้าหน้าที่
# เมื่อรันเว็บใน Docker บน Windows ให้ใช้ host.docker.internal แทน localhost
CITIZEN_CARD_READER_URL=http://host.docker.internal:47831/read-card
# Token ระหว่าง KU-MED กับโปรแกรมเครื่องอ่านบัตร ห้ามใช้ชื่อขึ้นต้นด้วย NEXT_PUBLIC_
CITIZEN_CARD_READER_TOKEN=
# URL สำหรับเริ่มเข้าสู่ระบบ KU All-Login (ฝั่ง server เท่านั้น)
# รอข้อมูลจริงจากผู้ดูแลระบบ เช่น https://accounts.ku.ac.th/authorize?...
KU_ALLLOGIN_URL=
# ระบบจำลองการส่ง OTP ทางอีเมล: true จะแสดงรหัสบนหน้าจอสำหรับสาธิตเท่านั้น
# เมื่อใช้งานจริงให้ตั้งเป็น false และเชื่อมบริการอีเมลฝั่งเซิร์ฟเวอร์
AUTH_EMAIL_MOCK=true
# บัญชีผู้ดูแลระบบหลักครั้งแรก (รหัสผ่านอย่างน้อย 12 ตัวอักษร)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=
