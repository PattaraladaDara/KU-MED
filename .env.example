# Local development only. Use a new password before deploying elsewhere.
POSTGRES_USER=ku_med
POSTGRES_PASSWORD=ku_med_local_dev
POSTGRES_DB=ku_med
POSTGRES_PORT=5433
APP_PORT=3000
DATABASE_URL=postgresql://ku_med:ku_med_local_dev@localhost:5433/ku_med?schema=public
# เบอร์โทร 10 หลัก หรือเลขประจำตัวผู้เสียภาษี/พร้อมเพย์ 13 หลัก สำหรับรับโอน
NEXT_PUBLIC_PROMPTPAY_ID=
# ข้อมูลแพทย์สำหรับบัญชีทดลอง ใช้ในใบรับรองแพทย์
NEXT_PUBLIC_DEMO_DOCTOR_NAME=
NEXT_PUBLIC_DEMO_MEDICAL_LICENSE=
# API ข้อมูลนิสิต (ฝั่ง server เท่านั้น) ใส่ {studentId} ตรงตำแหน่งรหัสนิสิต
# ตัวอย่าง: https://student-api.example.ac.th/students/{studentId}
STUDENT_LOOKUP_MOCK=false
STUDENT_LOOKUP_API_URL=
# ไม่ต้องใส่ถ้า API ไม่ใช้ Bearer token
STUDENT_LOOKUP_API_TOKEN=
